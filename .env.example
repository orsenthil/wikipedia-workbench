# Copy to .env; `uv run editor` loads it automatically.
WIKI_USER=Phoe6

# From https://en.wikipedia.org/wiki/Special:BotPasswords
# Grants needed: "View your watchlist" and "Edit your watchlist"
WIKI_BOT_USER=Phoe6@editor
WIKI_BOT_PASSWORD=

# Optional
# WIKI_API_URL=https://test.wikipedia.org/w/api.php
# EDITOR_DB=editor.db

# Required when deployed (generate with: uv run editor-hash-password)
# APP_PASSWORD_HASH=
# SESSION_SECRET=
